/**
 * Contract Name: Midnight Credential-Gated Anonymous Voting MVP (Level 4)
 * Source File: contracts/voting.compact
 * 
 * Product Specification & Technical Core:
 * --------------------------------------------
 * This Compact smart contract implements a privacy-preserving, credential-gated voting protocol on the Midnight blockchain.
 * 
 * 1. LEDGER STATE (Public On-Chain State):
 *    - proposalId: Bytes<32> - Unique 32-byte identifier for the voting proposal.
 *    - proposalText: Opaque<"string"> - Public description of the proposal subject.
 *    - yesTally: Counter - On-chain accumulator tracking affirmative votes.
 *    - noTally: Counter - On-chain accumulator tracking negative votes.
 *    - nullifierSet: Map<Bytes<32>, Boolean> - Spent nullifier registry blocking double voting without revealing voter identity.
 *    - votingOpen: Boolean - Administrative flag controlling poll status.
 *    - adminCommitment: Bytes<32> - Persistent hash commitment of admin secret key.
 *    - eligibilityRoot: Bytes<32> - Merkle tree root of authorized voter credential commitments (Depth-3 binary tree).
 * 
 * 2. PRIVATE WITNESS DECLARATIONS (Client-Side ZK Witness Inputs):
 *    - voterSecretKey(): Bytes<32> - Private credential key held by voter.
 *    - voteChoice(): Boolean - Private ballot selection (true = YES, false = NO).
 *    - adminSecretKey(): Bytes<32> - Private admin credential for poll closure.
 *    - merklePath(): Vector<3, Bytes<32>> - Merkle tree sibling nodes for depth-3 membership verification.
 *    - merkleLeftInputs(): Vector<3, Bytes<32>> - Left hash inputs per tree level for branchless verification.
 *    - merkleRightInputs(): Vector<3, Bytes<32>> - Right hash inputs per tree level for branchless verification.
 * 
 * 3. DISCLOSE USAGE & ZERO-KNOWLEDGE BOUNDARIES:
 *    - Constructor: disclose(pId), disclose(pText), disclose(adminCommit), disclose(eligRoot) expose public setup parameters.
 *    - castVote(): disclose(voteChoice()) declassifies vote direction to adjust public tally without linking to credential.
 *    - castVote(): disclose(persistentHash([sk, proposalId])) declassifies deterministic nullifier to enforce single-vote policy on-chain.
 *    - closeVoting(): disclose(persistentHash(adminSk) == adminCommitment) declassifies authorization boolean to freeze poll.
 */

pragma language_version 0.23;

import CompactStandardLibrary;

// Ledger state (public)
export ledger proposalId: Bytes<32>;
export ledger proposalText: Opaque<"string">;
export ledger yesTally: Counter;
export ledger noTally: Counter;
export ledger nullifierSet: Map<Bytes<32>, Boolean>;
export ledger votingOpen: Boolean;
export ledger adminCommitment: Bytes<32>;
export ledger eligibilityRoot: Bytes<32>;

// Private witness declarations
witness voterSecretKey(): Bytes<32>;
witness voteChoice(): Boolean;
witness adminSecretKey(): Bytes<32>;
witness merklePath(): Vector<3, Bytes<32>>;
witness merkleLeftInputs(): Vector<3, Bytes<32>>;
witness merkleRightInputs(): Vector<3, Bytes<32>>;

// Constructor to initialize state
constructor(pId: Bytes<32>, pText: Opaque<"string">, adminCommit: Bytes<32>, eligRoot: Bytes<32>) {
    proposalId = disclose(pId);
    proposalText = disclose(pText);
    votingOpen = true;
    adminCommitment = disclose(adminCommit);
    eligibilityRoot = disclose(eligRoot);
}

// Circuit to cast a vote
export circuit castVote(): [] {
    // Assert voting is currently open
    assert(votingOpen, "Voting is closed");

    // Retrieve private inputs via witness functions
    const sk = voterSecretKey();
    const choice = disclose(voteChoice());

    // 1. Compute the voter commitment: commitment = persistentHash(voterSecretKey)
    const commitment = persistentHash<Bytes<32>>(sk);

    // 2. Retrieve Merkle path and left/right inputs
    const path = merklePath();
    const leftInputs = merkleLeftInputs();
    const rightInputs = merkleRightInputs();

    // 3. Level 0 verification and hashing
    const left0 = leftInputs[0];
    const right0 = rightInputs[0];
    assert((left0 == commitment && right0 == path[0]) || (left0 == path[0] && right0 == commitment), "Invalid Merkle proof level 0");
    const node0 = persistentHash<Vector<2, Bytes<32>>>([left0, right0]);

    // 4. Level 1 verification and hashing
    const left1 = leftInputs[1];
    const right1 = rightInputs[1];
    assert((left1 == node0 && right1 == path[1]) || (left1 == path[1] && right1 == node0), "Invalid Merkle proof level 1");
    const node1 = persistentHash<Vector<2, Bytes<32>>>([left1, right1]);

    // 5. Level 2 verification and hashing
    const left2 = leftInputs[2];
    const right2 = rightInputs[2];
    assert((left2 == node1 && right2 == path[2]) || (left2 == path[2] && right2 == node1), "Invalid Merkle proof level 2");
    const node2 = persistentHash<Vector<2, Bytes<32>>>([left2, right2]);

    assert(node2 == eligibilityRoot, "Voter credential is not in the eligibility set");

    // 7. Derive credential nullifier inside the ZK proof: nullifier = persistentHash(credential secret key + proposal ID).
    // This serves as the double-vote guard: since the credential secret key is unique and validated,
    // the derived nullifier is deterministic. It prevents the same credential from voting twice
    // for this proposal, without revealing which credential it is or linking it to the wallet/vote.
    const nullifier = disclose(persistentHash<Vector<2, Bytes<32>>>([sk, proposalId]));

    // 8. Prevent double voting by asserting that the nullifier is not already recorded on the ledger
    assert(!nullifierSet.member(nullifier), "Double voting is not allowed");

    // 9. Register the nullifier on the ledger as spent
    nullifierSet.insert(nullifier, true);

    // Publicly increment tally delta without revealing choice-voter mapping
    if (choice) {
        yesTally.increment(1);
    } else {
        noTally.increment(1);
    }
}

// Circuit to close the voting period (admin-only)
export circuit closeVoting(): [] {
    const adminSk = adminSecretKey();
    // Validate admin credentials by verifying their secret key matches the commitment
    assert(disclose(persistentHash<Bytes<32>>(adminSk) == adminCommitment), "Unauthorized admin");
    votingOpen = false;
}
